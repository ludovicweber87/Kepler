{
	"name": "kepler",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"packages/agent",
		"packages/cli"
	],
	"scripts": {
		"dev": "node scripts/dev-auto-port.mjs",
		"dev:web": "node scripts/dev-auto-port.mjs --web-only",
		"dev:agent": "npm run dev -w packages/agent",
		"build": "next build",
		"start": "next start -p 4000",
		"lint": "eslint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"seed:personas": "node scripts/seed-personas.mjs",
		"test:web": "vitest run",
		"test:web:watch": "vitest"
	},
	"dependencies": {
		"@emotion/cache": "^11.14.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^7.3.9",
		"@mui/material": "^7.3.9",
		"@mui/x-date-pickers": "^9.9.0",
		"@tanstack/react-query": "^5.90.21",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/xterm": "^6.0.0",
		"better-sqlite3": "^12.8.0",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.1",
		"framer-motion": "^12.35.1",
		"next": "16.1.6",
		"next-intl": "^4.8.3",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"rehype-raw": "^7.0.0",
		"remark-gfm": "^4.0.1",
		"shiki": "4.3.1"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^4.7.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9",
		"eslint-config-next": "16.1.6",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"jsdom": "^25.0.1",
		"prettier": "^3.8.1",
		"tsx": "^4.21.0",
		"typescript": "^5",
		"vitest": "^3.2.7"
	}
