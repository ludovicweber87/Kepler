		},
		"features": {
			"kanban": {
				"title": "Issues & Kanban",
				"desc": "Kanban-Board synchronisiert mit GitHub Projects V2.",
				"details": "Verschiebe Issues per Drag-and-drop zwischen Statusspalten, filtere nach Ansicht und sieh die Echtzeit-Synchronisation mit deinen GitHub Project-Boards. Jede Statusänderung wird sofort auf beiden Seiten übernommen."
			},
			"prs": {
				"title": "Pull Requests",
				"desc": "Verfolge PRs und CI-Checks über alle Repos hinweg.",
				"details": "Sieh alle offenen PRs in einer Ansicht mit Live-CI-Status, Review-Anfragen und Diff-Statistiken. Merge mit einem Klick per Squash Merge. Kein Wechsel mehr zwischen Repos nötig."
			},
			"parallel": {
				"title": "Parallele KI-Sitzungen",
				"desc": "Mehrere Claude Agents auf separaten Branches.",
				"details": "Weise einem Agent ein Issue zu, er erstellt einen Worktree-Branch und arbeitet autonom. Führe mehrere parallel aus — jeder Agent bearbeitet sein eigenes Issue unabhängig mit vollständiger Aktivitätsprotokollierung."
			},
			"workspace": {
				"title": "Einheitlicher Arbeitsbereich",
				"desc": "Aufgaben, Branches, Skills — an einem Ort.",
				"details": "Verwalte Aufgabenlisten pro Repo, durchsuche Git-Branches mit Commit-Verlauf, konfiguriere Agent-Vorlagen und Skills. Alles, was dein Team braucht, ohne das Dashboard zu verlassen."
			}
		}
	},
