	"landing": {
		"nav": {
			"cta": "Sign in with GitHub"
		},
		"hero": {
			"tagline": "One dashboard, all your dev workflow",
			"subtitle": "Manage your GitHub issues, pull requests, and parallel AI sessions from a single unified interface. Built for teams who ship fast.",
			"cta": "Get started with GitHub"
		},
		"features": {
			"kanban": {
				"title": "Issues & Kanban",
				"desc": "Kanban board synced to GitHub Projects V2.",
				"details": "Drag-and-drop issues across status columns, filter by view, and see real-time sync with your GitHub Project boards. Every status change is reflected instantly on both sides."
			},
			"prs": {
				"title": "Pull Requests",
				"desc": "Track PRs and CI checks across all repos.",
				"details": "See all open PRs in one view with live CI status, review requests, and diff stats. Merge with one click using squash merge. No more switching between repos."
			},
			"parallel": {
				"title": "Parallel AI Sessions",
				"desc": "Multiple Claude agents on separate branches.",
				"details": "Assign an issue to an agent, it creates a worktree branch and works autonomously. Run several in parallel — each agent tackles its own issue independently with full activity logging."
			},
			"workspace": {
				"title": "Unified Workspace",
				"desc": "Todos, branches, skills — one place.",
				"details": "Manage todo lists per repo, browse git branches with commit history, configure agent presets and skills. Everything your team needs without leaving the dashboard."
			}
		}
	},
